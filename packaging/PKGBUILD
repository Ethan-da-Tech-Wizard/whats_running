# Maintainer: Ethan <thatpoolguye@gmail.com>
pkgname=whats-running-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Honest, local-first Linux background-activity inspector for Arch/systemd/cgroup-v2"
arch=('x86_64' 'aarch64')
url="https://github.com/Ethan-da-Tech-Wizard/whats-running"
license=('MIT' 'Apache-2.0')
depends=('systemd' 'gcc-libs')
makedepends=('cargo' 'git')
provides=('whats-running')
conflicts=('whats-running')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/whats-running "$pkgdir/usr/bin/whats-running"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
